# Chatbot (server-side only, never exposed to the client)
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5
ANTHROPIC_MODEL=

# Supabase project (used for the admin-curated news/research forum)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never prefix with NEXT_PUBLIC_ — this key bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Password required to access /admin and publish forum posts.
# Pick a long random value.
ADMIN_SECRET=

# Stripe (Premium subscription billing)
STRIPE_SECRET_KEY=
# From the Stripe webhook endpoint's "Signing secret".
STRIPE_WEBHOOK_SECRET=
# The recurring Price ID for the Premium plan (e.g. price_123...).
STRIPE_PRICE_ID=
